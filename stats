import sys


def parse_num(s):
    text = s.strip()
    if text == "":
        raise ValueError("empty")
    try:
        return int(text)
    except ValueError:
        return float(text)


def parse_args(args):
    mapping = {
        "-c": "count",
        "--count": "count",
        "-s": "sum",
        "--sum": "sum",
        "-a": "mean",
        "--avg": "mean",
        "--min": "min",
        "--max": "max",
    }
    if not args:
        return ["count", "sum", "mean", "min", "max"]

    selected = []
    for arg in args:
        if arg not in mapping:
            raise ValueError(f"unknown option: {arg}")
        key = mapping[arg]
        if key not in selected:
            selected.append(key)
    return selected


def main():
    try:
        fields = parse_args(sys.argv[1:])
    except ValueError as e:
        print(f"Error: {e}", file=sys.stderr)
        sys.exit(1)

    nums = []
    for line in sys.stdin:
        try:
            nums.append(parse_num(line))
        except ValueError:
            print(f"Error: invalid number: {line.rstrip()}", file=sys.stderr)
            sys.exit(1)

    if not nums:
        print("Error: no input data", file=sys.stderr)
        sys.exit(1)

    total = sum(nums)
    values = {
        "count": len(nums),
        "sum": total,
        "mean": total / len(nums),
        "min": min(nums),
        "max": max(nums),
    }

    for field in fields:
        print(f"{field}: {values[field]}")


if __name__ == "__main__":
    main()

